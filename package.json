{
  "name": "taijuda-amulet-archive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build --prerender-all",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "vinext start",
    "local:build": "node scripts/local-site.mjs build",
    "local:start": "node scripts/local-site.mjs start",
    "local:stop": "node scripts/local-site.mjs stop",
    "local:status": "node scripts/local-site.mjs status",
    "local:backup": "node scripts/local-site.mjs backup",
    "preview": "node scripts/preview-server.mjs",
    "content:seed": "node --experimental-strip-types scripts/sync-published-content.mjs --seed",
    "content:sync": "node scripts/sync-published-content.mjs",
    "build:publish": "npm run content:sync && npm run build:pages",
    "test": "npm run build && npm run test:core",
    "test:core": "node --import tsx --test tests/rendered-html.test.mjs tests/article-routes.test.mjs tests/article-editor-contract.test.mjs tests/published-snapshot.test.mjs tests/commerce-core.test.mjs tests/content-core.test.mjs tests/site-builder-core.test.mjs tests/admin-system.test.mjs tests/admin-chrome-contract.test.mjs tests/member-device-storage.test.mjs",
    "test:pages": "npm run build:pages && node scripts/verify-pages-export.mjs",
    "audit:prod": "npm audit --omit=dev",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@puckeditor/core": "^0.22.4",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "miniflare": "4.20260730.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "type": "module"
}
